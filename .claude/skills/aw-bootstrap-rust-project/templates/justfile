set shell := ["bash", "-euo", "pipefail", "-c"]

base := "origin/main"

default:
    @just --list

fmt:
    cargo fmt --all --check

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

test:
    cargo nextest run --workspace --all-features
    cargo test --workspace --doc

# Production code only: test files are excluded so coverage and CRAP never score tests
cov:
    cargo llvm-cov nextest --workspace --all-features --lcov --output-path lcov.info --ignore-filename-regex '(/tests/|/tests\.rs$|_tests\.rs$)'

# Behavior lock on the diff for one crate: just mutants billing
mutants pkg:
    git diff {{base}}...HEAD > pr.diff
    cargo mutants --in-diff pr.diff -p {{pkg}} --baseline=skip --timeout 60 -- --lib

crap: cov
    cargo crap --lcov lcov.info --workspace --fail-regression

deny:
    cargo deny check

audit:
    cargo audit

# Public API diff for one crate: just api billing
api pkg:
    cargo public-api diff {{base}}..HEAD -p {{pkg}}

doc:
    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features

# Fail on .rs files over 400 non-test lines unless marked `// size-exempt: reason` (rules/10-file-structure.md)
file-size:
    #!/usr/bin/env bash
    set -euo pipefail
    bad=0
    while IFS= read -r f; do
      case "$f" in */tests.rs|*_tests.rs|*/tests/*) continue;; esac
      grep -q 'size-exempt:' "$f" && continue
      n=$(awk '/#\[cfg\(test\)\]/{exit} {c++} END{print c+0}' "$f")
      if [ "$n" -gt 400 ]; then echo "too big ($n lines): $f"; bad=1; fi
    done < <(git ls-files '*.rs')
    exit $bad

ci: fmt lint test file-size deny audit doc
