# Copy to `.env` and fill in what you need. Nothing here is required to run
# the pipeline — without email/vault config, `/news-digest` runs and reports
# what it *would* have delivered. See README.md for the full walkthrough,
# including Fastmail-specific settings.

# --- Email / Send-to-Kindle ---
# NEWS_DIGEST_SMTP_HOST=smtp.fastmail.com
# NEWS_DIGEST_SMTP_PORT=465
# NEWS_DIGEST_SMTP_USERNAME=you@fastmail.com
# NEWS_DIGEST_SMTP_PASSWORD=your-app-password
# NEWS_DIGEST_EMAIL_FROM=you@fastmail.com
# NEWS_DIGEST_EMAIL_TO=your-kindle-address@kindle.com

# --- Obsidian vault ---
# NEWS_DIGEST_OBSIDIAN_VAULT_PATH=/path/to/your/vault

# --- Optional ---
# NEWS_DIGEST_EXTRACTOR=trafilatura       # or "defuddle" — default is trafilatura
# NEWS_DIGEST_SYNTHESIS_ENABLED=true      # default is off
# NEWS_DIGEST_STATE_PATH=/custom/path/run_state.json
